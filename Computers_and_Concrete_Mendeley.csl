<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Computers and Concrete (Techno-Press, Mendeley custom)</title>
    <title-short>Computers and Concrete</title-short>
    <id>http://www.zotero.org/styles/computers-and-concrete-techno-press-mendeley-custom</id>
    <link href="http://www.zotero.org/styles/computers-and-concrete-techno-press-mendeley-custom" rel="self"/>
    <link href="https://www.techno-press.org/?journal=cac" rel="documentation"/>
    <author>
      <name>Custom style based on the supplied Computers and Concrete journal sample</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Numeric citations and reference list matching the supplied Computers and Concrete article sample.</summary>
    <updated>2026-09-30T00:00:00+00:00</updated>
  </info>
  <macro name="contributors">
    <choose>
      <if variable="author">
        <names variable="author" delimiter=", ">
          <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", "/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor" delimiter=", ">
          <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", "/>
        </names>
      </else-if>
    </choose>
  </macro>
  <macro name="year">
    <date variable="issued" date-parts="year" prefix="(" suffix=")"/>
  </macro>
  <macro name="source">
    <choose>
      <if type="article-journal article-magazine article-newspaper review review-book" match="any">
        <group delimiter=", ">
          <text variable="container-title"/>
          <group delimiter="">
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
          <text variable="article-number"/>
        </group>
      </if>
      <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=", ">
          <text variable="container-title"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text variable="volume"/>
          <text variable="page"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="identifier">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" line-spacing="1" second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=" ">
        <group delimiter=" ">
          <text macro="contributors" suffix="."/>
          <text macro="year" suffix="."/>
        </group>
        <text variable="title" suffix="."/>
        <group delimiter=". ">
          <text macro="source"/>
          <text macro="identifier"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>

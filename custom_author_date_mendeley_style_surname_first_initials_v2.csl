<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Custom Author-Date — All Authors Surname First + Initials</title>
    <id>http://www.zotero.org/styles/custom-author-date-all-surname-first-initials-v2</id>
    <link href="http://www.zotero.org/styles/custom-author-date-all-surname-first-initials-v2" rel="self"/>
    <link href="http://www.zotero.org/styles/taylor-and-francis-chicago-author-date" rel="template"/>
    <author><name>Custom style for Mendeley</name></author>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <updated>2026-09-08T00:00:00+00:00</updated>
  </info>

  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="always"
            and="symbol"/>
    </names>
  </macro>

  <macro name="author-cite">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>

  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="title" quotes="true"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="journal">
    <group delimiter=" ">
      <text variable="container-title" font-style="italic"/>
      <text variable="volume"/>
      <text variable="issue" prefix="(" suffix=")"/>
    </group>
  </macro>

  <macro name="pages-or-article-number">
    <choose>
      <if variable="page"><text variable="page"/></if>
      <else-if variable="number"><text variable="number"/></else-if>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="doi-url">
    <choose>
      <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
      <else-if variable="URL"><text variable="URL"/></else-if>
    </choose>
  </macro>

  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author-cite"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-bib"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author-bib"/>
        <text macro="year"/>
        <text macro="title"/>
        <choose>
          <if type="article-journal" match="any">
            <group>
              <text macro="journal"/>
              <text macro="pages-or-article-number" prefix=": "/>
            </group>
          </if>
          <else>
            <text macro="publisher"/>
          </else>
        </choose>
        <text macro="doi-url"/>
      </group>
    </layout>
  </bibliography>
</style>
